/* eslint-disable */
// Umber Flute — Originkit

"use client"

import { addPropertyControls, ControlType } from "framer"
import { useEffect, useRef, useState } from "react"
import type { CSSProperties, KeyboardEvent as ReactKeyboardEvent } from "react"

/*
 * UmberFlute — a frosted, reeded-glass capsule button. Behind the reeds a
 * dark body with an ember-lit rim turns on a slow loop, and an indigo light
 * washes in from the left and fades again.
 *
 * Built after a 12 s screen recording (960 × 720, 30 fps) of a "Searching…"
 * pill: six vertical reeds of frosted glass over a soft grey scene, two dark
 * bodies whose edges catch a thin amber light, smeared sideways by the reeds
 * and stepped from one reed to the next. The scene repeats every 3.1 s
 * (93 frames).
 *
 * Measured off the frames (capsule 664 × 200, centred):
 *   six reeds 110.7 px wide · each reed shows a strip of the scene 0.275 of
 *   its own width, stretched across it, and each sits 22.1 px lower in the
 *   scene than the reed to its left (fitted with the scene) · reed joints
 *   ~+12/255 lighter over a few px · shade ≈ rgb(9,8,12), ember up to
 *   rgb(141,89,33), a soft glow round a brighter core · indigo ≈
 *   rgb(55,58,74) at its height · bottom frost lifts to ~157 at 13 px above
 *   the rim, 1.0·exp(−(d − 4) / 10 px), fitted to the time-mean profile ·
 *   rim a 1.5 px light line ≈ 235 · faint drop shadow · type white 252,
 *   centred, 331 px wide, set in Inter 500 (the closest Google face; the
 *   clip looks like SF Pro).
 * The scene motion was fitted per reed, band and loop phase (rms 19/255) as
 * first harmonics of the loop: an edge y = a0 + a1·x + a2·x² below which the
 * lower body lies, and a disc (centre, radius) for the upper-left body.
 *
 * Interaction, added on top of the recording (it shows none):
 * - Hover: under the pointer the reeds melt into a drop of clear glass, a
 *   lens through which the scene behind is seen whole, unfrosted and
 *   magnified, where the reeds around it smear it into strips. Toward its
 *   rim the view squeezes and splits into a thin colour fringe, a dark band
 *   runs just inside the edge and a light line rides the rim, as on a real
 *   drop of glass. It swells in with a little overshoot, stretches along
 *   the way the pointer moves, and shrinks away when the pointer leaves.
 * - Press: the drop bulges (magnifying harder for a moment), the capsule
 *   gives a little and the reeds wobble, a wave running out from the press
 *   point across them.
 *
 * How it is built:
 * - One WebGL2 canvas covering the capsule and its shadow room draws the
 *   scene, reeds, frost, rim and shadow in a single pass. The scene is a
 *   handful of analytic shapes, so there is nothing to bake or upload but a
 *   few uniforms per frame.
 * - The click target and label are a real <a>/<button> laid over the shape
 *   with the same transform, so keyboard, screen readers and hit-testing are
 *   the browser's own and the type stays crisp.
 * - Frames are vsync-locked at 60 fps while the scene moves, pause off screen
 *   or in a hidden tab, and stop entirely when Speed is 0 (or with reduced
 *   motion) once everything has settled.
 */

// ---------------------------------------------------------------- constants

const REF_W = 960
const REF_H = 720
const REF_ASPECT = REF_W / REF_H
const MAX_DPR = 2
const PIXEL_CAP = 2.6e6
const PERSPECTIVE = 1000 // ref px: the lens Tilt leans the button under
const MARGIN_X = 0.25 // shadow / squish room round the capsule, shares of its height
const MARGIN_T = 0.2
const MARGIN_B = 0.45
const UNIT_H = 200 // scene units are px on a capsule this tall

const LOOP_S = 3.1 // the recording's loop at Speed 5: 93 frames at 30 fps

// Scene motion: [mean, cos, sin] of the loop phase, in scene units (x right,
// y down, from the capsule centre). Fitted, see header.
const EDGE_A0 = [-58.76, 33.63, -3.4]
const EDGE_A1 = [0.1736, -0.339, 0.0943]
const EDGE_A2 = [1.66, 1.769, -0.579] // ×1e-3
const DISC_X = [-163.8, 4.18, 4.16]
const DISC_Y = [-18.4, 34.2, -14.96]
const DISC_R = [156.2, -2.74, -7.41]
const POOL_K = [1.089, -0.089, 0.344] // a pale pool of light low on the left
const POOL_AT = [-139.7, 133.2]
const POOL_TINT = 2.0 // its colour, as a multiple of the ground's
// The indigo is a tint, not added light: it barely moves the brightness (a
// band-mean fit drops it), but turns the left third from neutral to
// rgb(57,60,74) half a loop in.
const GLOW_K = [0.175, -0.175, 0]
const GLOW_AT = [-250, 20] // centre of the indigo light
const LIGHT_SIZE = [230, 200] // both lights' reach

// Reeds.
const REEDS = 6
const REED_M = 0.275 // scene strip each reed shows, of its own width
const REED_DY = 22.1 // scene units each reed sits below the one to its left
const REED_JOINT = 0.05 // light on the joints
const REED_LENS = 0.04 // light toward each reed's sides

// Scene tone.
const GROUND_GX = 0.088 // ground light across, per 300 units
const GROUND_GY = -0.853 // and down, per 100 units: lit from above
const SOFT = 6.07 // body edge softness, units
// The bodies absorb the light falling on them: the fit puts their tone 0.072
// below black, so the pool and ember add little over them. Shade sits that
// far above the floor the shader starts from.
const SHADE_SINK = 0.107
const EMBER_GLOW = 0.106 // the ember's soft glow along the edge
const EMBER_WIDE = 11.1 // its half-width, units
const EMBER_LINE = 0.2 // and the thin bright line at its heart
const EMBER_THIN = 4.2

// Glass, on a 200 px capsule, kept as shares of its height.
const FROST_K = 1.0 // bottom frost
const FROST_OFF = 4 / 200
const FROST_D = 10 / 200
const TOP_K = 0.22 // thin haze under the top rim
const TOP_D = 4 / 200
const HAZE_K = 0.12 // haze round the whole outline
const HAZE_D = 14 / 200
const SHADOW_A = 0.22
const SHADOW_DY = 0.06
const SHADOW_D = 0.11

// Label: Inter 500, the closest Google face to the recording's lettering
// (by eye; every candidate scored IoU ≈ 0.65, the clip is likely SF Pro).
const LABEL_SIZE = 0.302 // font size, of the button height, when the Font sets none

// Interaction.
const LENS_R = 62 // the drop's radius at Lens 5, scene units
const LENS_MAG = 1.5 // magnification at its centre at Bend 5
const LENS_RIM = 1.35 // view scale at its rim (> 1 squeezes more of the scene in)
const PRISM = 0.12 // colour split at the rim at Prism 5, share of the view
const STRETCH = 0.4 // most the drop stretches along its motion
const STRETCH_V = 700 // pointer speed (scene units/s) for most of that stretch
const PULSE = 0.35 // extra magnification a press gives, at its height
const WOBBLE = 22 // scene units of reed wobble at Ripple 5
const WOBBLE_DECAY = 3.2 // 1/s
const SQUISH = 0.975

// ---------------------------------------------------------------- types

