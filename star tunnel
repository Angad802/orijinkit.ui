/** Extra uniforms for this effect, set every frame. */
function effectUniforms(gl: WebGL2RenderingContext, u: (name: string) => WebGLUniformLocation | null, p: Props): void {
    const adv = { ...ADVANCED_DEFAULTS, ...(p.advanced ?? {}) }
    const n = (v: unknown, d: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, num(v, d)))
    const f1 = (name: string, v: number) => gl.uniform1f(u(name), v)
    const c3 = (name: string, v: string | undefined, d: RGBA) => {
        const c = parseColor(v, d)
        gl.uniform3f(u(name), c[0], c[1], c[2])
    }
    const scale = n(p.scale, 100, 10, 300) / 100
    f1("uSides", Math.round(n(p.walls, 4, 3, 12)))
    f1("uFlicker", n(p.flicker, 50, 0, 100) / 100)
    f1("uGlow", n(p.glow, 60, 0, 100) / 100)
    f1("uHoverAmt", n(adv.hover, 50, 0, 100) / 50)
    gl.uniform2f(u("uVp"), n(adv.vanishX, 50, 0, 100) / 100, 1 - n(adv.vanishY, 50, 0, 100) / 100)
    f1("uTurn", (n(adv.wallTurn, 0, -180, 180) * Math.PI) / 180)
    f1("uFocal", n(adv.focal, 50, 5, 300) / 100)
    f1("uFly", n(adv.flySpeed, 130, 0, 1000) / 100)
    f1("uCols", Math.max(2, Math.round(n(adv.columns, 12, 2, 60) / Math.max(0.1, scale))))
    f1("uDepthAspect", n(adv.panelAspect, 100, 20, 400) / 100)
    f1("uGap", n(adv.gap, 32, 0, 80) / 100)
    gl.uniform4f(
        u("uShares"),
        n(adv.dimShare, 22, 0, 100) / 100,
        n(adv.litShare, 22, 0, 100) / 100,
        n(adv.hotShare, 4, 0, 100) / 100,
        n(adv.flashShare, 5, 0, 100) / 100
    )
    f1("uFlashS", n(adv.flashMs, 400, 50, 1500) / 1000)
    f1("uHoldS", n(adv.holdMs, 600, 50, 5000) / 1000)
    c3("uDim", adv.dimColor, [0.04, 0.16, 0.47, 1])
    c3("uDeep", adv.deepColor, [0.02, 0.04, 0.12, 1])
    c3("uHot", adv.hotColor, [0.56, 0.9, 1, 1])
    c3("uFlash", adv.flashColor, [0.92, 0.97, 1, 1])
    c3("uSpark", adv.sparkColor, [1, 1, 1, 1])
    f1("uFog", n(adv.fog, 8, 0, 100) / 100)
    f1("uNearDim", n(adv.nearDim, 12, 0, 100) / 100)
    f1("uGrad", n(adv.gradient, 35, 0, 100) / 100)
    f1("uSparkShare", n(adv.sparkShare, 10, 0, 100) / 100)
    f1("uSparkSize", n(adv.sparkSize, 6, 1, 50) / 100)
    f1("uCrease", n(adv.crease, 70, 0, 100) / 100)
    f1("uEdgeSoft", n(adv.edgeSoft, 20, 0, 100) / 100)
    f1("uExposure", n(adv.exposure, 110, 10, 300) / 100)
    f1("uGrain", n(adv.grain, 0, 0, 100) / 100)
    f1("uVignette", n(adv.vignette, 0, 0, 100) / 100)
}

/* A camera flying down an endless polygon tunnel whose flat walls carry sparse
   emissive panels on black. Per pixel: the wall it sees (angle folded into N
   sectors), depth z = f / (r·cos(localAngle)), along-wall coordinate tan(localAngle),
   and the panel grid in (across, depth + travel). Most panels are dark; a share glow
   saturated blue / cyan with a bloom halo, a few go white-cyan, clusters flash,
   sparks sit on grid vertices, the far mesh fades to its (dark) area mean. */
const FRAG = `#version 300 es
precision highp float;
uniform vec2 uRes;
uniform float uTime;
uniform vec2 uMouse;
uniform float uHover;
uniform vec3 uBg;
uniform vec3 uBase;
uniform vec3 uAccent;
uniform float uSides;
uniform float uFlicker;
uniform float uGlow;
uniform float uHoverAmt;
uniform vec2 uVp;
uniform float uTurn;
uniform float uFocal;
uniform float uFly;
uniform float uCols;
uniform float uDepthAspect;
uniform float uGap;
uniform vec4 uShares;
uniform float uFlashS;
uniform float uHoldS;
uniform vec3 uDim;
uniform vec3 uDeep;
uniform vec3 uHot;
uniform vec3 uFlash;
uniform vec3 uSpark;
uniform float uFog;
uniform float uNearDim;
uniform float uGrad;
uniform float uSparkShare;
uniform float uSparkSize;
uniform float uCrease;
uniform float uEdgeSoft;
uniform float uExposure;
uniform float uGrain;
uniform float uVignette;
out vec4 outColor;

float h21(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

// shares: x = dim navy, y = lit blue/cyan, z = hot white-cyan; the rest are near-black
vec3 panelCol(vec2 id, float ep, out float lit) {
    float r = h21(id + ep * vec2(17.13, 3.71));
    float r2 = h21(id * 1.37 + ep * vec2(5.31, 11.97) + 41.0);
    float fl = mix(0.4, 1.6, uFlicker);
    float hot = uShares.z * fl;
    float cy = uShares.y * fl;
    float dm = uShares.x;
    if (r < hot) { lit = 1.0; return mix(uHot, uFlash, r2 * 0.6); }
    if (r < hot + cy) {
        lit = 0.8;
        vec3 c = mix(uBase, uAccent, smoothstep(0.3, 1.0, r2));
        return c * mix(0.8, 1.15, h21(id.yx + ep * 1.7));
    }
    if (r < hot + cy + dm) { lit = 0.15; return mix(uDim, uBase * 0.45, r2 * 0.5) * mix(0.55, 1.0, r2); }
    lit = 0.0;
    return uDeep * mix(0.3, 0.85, r2);
}

void main() {
    float hv = uHover * uHoverAmt;
    vec2 vp = uVp + (uMouse - 0.5) * 0.12 * hv;
    vec2 q = (gl_FragCoord.xy - vp * uRes) / uRes.y;
    float r = max(length(q), 1e-4);
    float sides = max(uSides, 3.0);
    float sw = 6.2831853 / sides;
    float a = atan(q.y, q.x) - uTurn;
    float raw = floor(a / sw + 0.5);
    float la = a - raw * sw;
    float sec = mod(raw, sides);
    float d = max(r * cos(la), 1e-4);
    float z = uFocal / d;
    float halfW = tan(3.14159265 / sides);
    float wu = tan(la);
    float pitchU = 2.0 * halfW / max(uCols, 1.0);
    float pitchZ = max(pitchU * uDepthAspect, 1e-4);
    float zz = z + uTime * uFly;
    vec2 g = vec2((wu + halfW) / pitchU, zz / pitchZ);
    vec2 w = fwidth(g);
    float wm = max(w.x, w.y);

    vec2 id = floor(g);
    vec2 f = g - id;
    vec2 cid = id + vec2(sec * 97.0, 0.0);

    float blur = smoothstep(0.3, 0.85, wm);
    float near = 1.0 - smoothstep(0.5, 1.6, z);
    vec2 ew = 0.5 * min(w, vec2(0.5)) + uEdgeSoft * 0.25 * near;
    float hb = 0.5 - uGap * 0.5;
    vec2 c = abs(f - 0.5);
    vec2 m2 = 1.0 - smoothstep(vec2(hb) - ew, vec2(hb) + ew, c);
    float mask = m2.x * m2.y;

    // per-cell level, held then switched
    float hc = h21(cid + 7.0);
    float holdS = max(uHoldS, 0.05);
    float e = uTime / holdS + hc * 7.0;
    float ep = floor(e);
    float tr = smoothstep(0.0, 0.05 / holdS, fract(e));
    float lit0;
    float lit1;
    vec3 c0 = panelCol(cid, ep - 1.0, lit0);
    vec3 c1 = panelCol(cid, ep, lit1);
    vec3 pc = mix(c0, c1, tr);
    float lit = mix(lit0, lit1, tr);

    // patchy brighter / darker wall sections, locked to the world
    float band = mix(0.65, 1.0, h21(floor(cid / vec2(4.0, 5.0)) + 3.3));
    pc *= band;

    // flash clusters: a block of neighbouring panels goes white-cyan
    vec2 kid = vec2(floor(id.x / 5.0) + sec * 31.0, floor(id.y / 6.0));
    float P = 1.6;
    float kph = uTime / P + h21(kid + 9.1);
    float kep = floor(kph);
    float kon = step(h21(kid + kep * 7.31), uShares.w * mix(0.4, 1.6, uFlicker));
    float kt = fract(kph) * P / max(uFlashS, 0.05);
    float env = smoothstep(0.0, 0.25, kt) * (1.0 - smoothstep(0.625, 1.0, kt));
    float incl = step(0.45, h21(cid * 0.71 + kep));
    float fl = kon * env * incl;
    pc = mix(pc, mix(uHot, uFlash, smoothstep(0.3, 0.8, fl)), fl);
    lit = max(lit, fl);

    // light by depth
    float fogP = exp(-max(z - 1.0, 0.0) * uFog);
    float fogS = exp(-max(z - 1.0, 0.0) * uFog * 0.5);
    float nearD = mix(1.0 - uNearDim, 1.0, smoothstep(0.45, 1.5, z));
    float grad = 1.0 + uGrad * (f.y - 0.5) * (0.4 + lit);
    float cd = (halfW - abs(wu)) / pitchU;
    float creaseK = mix(1.0 - uCrease, 1.0, smoothstep(0.0, 1.2, cd));

    // glassy lit panels: a touch brighter toward the middle
    float core = 1.0 + 0.25 * lit * (1.0 - smoothstep(0.0, hb, max(c.x, c.y)));
    vec3 panel = pc * grad * core * nearD * fogP * creaseK;
    vec3 beam = uBg + uDeep * 0.12 * fogP;
    vec3 col = mix(beam, panel, mask);
    vec2 dd = max(c - hb, 0.0);
    col += pc * lit * uGlow * 1.6 * exp(-length(dd) * 11.0) * (1.0 - mask) * fogP * nearD * creaseK;

    // far mesh below a pixel: its area mean (mostly dark, a little lit blue)
    float fill = (1.0 - uGap) * (1.0 - uGap);
    vec3 meanP = uDeep * 0.5 + uDim * uShares.x + mix(uBase, uAccent, 0.4) * uShares.y * 0.8;
    vec3 avg = mix(beam, meanP * fogP, fill);
    col = mix(col, avg, blur);

    // sparks on grid vertices, denser along the creases
    vec2 gc = floor(g + 0.5);
    vec2 fv = g - gc;
    vec2 sid = gc + vec2(sec * 97.0, 0.0);
    float hs = h21(sid * 1.31 + 3.7);
    float creaseNear = 1.0 - smoothstep(0.0, 2.0, cd);
    if (hs < uSparkShare * (1.0 + 2.0 * creaseNear)) {
        float tw = step(h21(sid + floor(uTime * 2.0 + hs * 9.0) * 3.1), 0.75);
        float rad = max(uSparkSize, wm);
        float d2 = dot(fv, fv) / (rad * rad);
        float sc = exp(-d2 * 2.0);
        float halo = 0.35 * exp(-sqrt(d2) * 1.2);
        col += (uSpark * sc + uAccent * halo) * tw * fogS * (1.0 - blur * 0.5) * 1.1;
    }

    // pointer: panels near it light up
    vec2 uv = gl_FragCoord.xy / uRes;
    vec2 pm = (uv - uMouse) * vec2(uRes.x / max(uRes.y, 1.0), 1.0);
    col *= 1.0 + 0.7 * hv * exp(-dot(pm, pm) * 10.0);

    col *= uExposure;
    vec2 vq = (uv - 0.5) * vec2(uRes.x / max(uRes.y, 1.0), 1.0);
    col *= 1.0 - uVignette * smoothstep(0.3, 1.0, length(vq));
    col += (h21(gl_FragCoord.xy + fract(uTime * 7.3) * 917.0) - 0.5) * uGrain * 0.12;
    outColor = vec4(clamp(col, 0.0, 1.0), 1.0);
}`

// ══ /EFFECT ═════════════════════════════════════════════════════════════════

interface Props extends EffectProps {
    background?: string
    baseColor?: string
    accentColor?: string
    speed?: number
    scale?: number
    style?: CSSProperties
}

function num(v: unknown, d: number): number {
    return typeof v === "number" && Number.isFinite(v) ? v : d
}

const VERT = `#version 300 es
in vec2 aPos;
void main() { gl_Position = vec4(aPos, 0.0, 1.0); }`

export default function StarPanelTunnel(props: Props) {
    props = withMovedControls(props)
    // Read live from propsRef; destructured here so their defaults sit in the signature.
    const { background = "#01020A", baseColor = "#1652E8", accentColor = "#22C4F4", speed = 42, scale = 300, style } = props
    void [baseColor, accentColor, speed, scale]
    const rootRef = useRef<HTMLDivElement>(null)
    const canvasRef = useRef<HTMLCanvasElement>(null)
    const propsRef = useRef(props)
    propsRef.current = props

    useEffect(() => {
        const root = rootRef.current
        const canvas = canvasRef.current
        if (!root || !canvas) return
        const gl = canvas.getContext("webgl2", { alpha: false, antialias: false, depth: false })
        if (!gl) return
        const reduced = typeof window.matchMedia === "function" && window.matchMedia("(prefers-reduced-motion: reduce)").matches

        const sh = (type: number, src: string) => {
            const s = gl.createShader(type)!
            gl.shaderSource(s, src)
            gl.compileShader(s)
            if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) console.error("StarPanelTunnel shader:", gl.getShaderInfoLog(s))
            return s
        }
        const prog = gl.createProgram()!
        gl.attachShader(prog, sh(gl.VERTEX_SHADER, VERT))
        gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG))
        gl.linkProgram(prog)
        if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
            console.error("StarPanelTunnel link:", gl.getProgramInfoLog(prog))
            return
        }
        gl.useProgram(prog)
        const buf = gl.createBuffer()
        gl.bindBuffer(gl.ARRAY_BUFFER, buf)
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW)
        const loc = gl.getAttribLocation(prog, "aPos")
        gl.enableVertexAttribArray(loc)
        gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0)
        const cache = new Map<string, WebGLUniformLocation | null>()
        const u = (name: string) => {
            if (!cache.has(name)) cache.set(name, gl.getUniformLocation(prog, name))
            return cache.get(name) ?? null
        }

        let W = 0
        let H = 0
        const resize = () => {
            W = root.offsetWidth
            H = root.offsetHeight
            const dpr = Math.min(window.devicePixelRatio || 1, 2)
            canvas.width = Math.max(1, Math.round(W * dpr))
            canvas.height = Math.max(1, Math.round(H * dpr))
        }
        const ro = new ResizeObserver(resize)
        ro.observe(root)
        resize()

        let mx = 0.5
        let my = 0.5
        let tx = 0.5
        let ty = 0.5
        let over = 0
        let hov = 0
        const onMove = (e: PointerEvent) => {
            if (W <= 0 || H <= 0) return
            tx = e.offsetX / W
            ty = 1 - e.offsetY / H
            over = 1
        }
        const onLeave = () => {
            over = 0
        }
        canvas.addEventListener("pointermove", onMove)
        canvas.addEventListener("pointerleave", onLeave)

        let clock = 0
        let raf = 0
        let last = -1
        const frame = (now: number) => {
            raf = requestAnimationFrame(frame)
            const dt = last < 0 ? 0 : Math.min((now - last) / 1000, 1 / 20)
            last = now
            const p = propsRef.current
            clock = (clock + dt * (Math.max(0, Math.min(100, num(p.speed, 50))) / 50) * (reduced ? 0.25 : 1)) % 3600
            const k = 1 - Math.exp(-dt * 6)
            mx += (tx - mx) * k
            my += (ty - my) * k
            hov += (over - hov) * k
            const bg = parseColor(p.background, [0.03, 0.03, 0.04, 1])
            const base = parseColor(p.baseColor, [0.23, 0.18, 0.55, 1])
            const acc = parseColor(p.accentColor, [0.91, 0.42, 0.57, 1])
            gl.viewport(0, 0, canvas.width, canvas.height)
            gl.uniform2f(u("uRes"), canvas.width, canvas.height)
            gl.uniform1f(u("uTime"), clock)
            gl.uniform2f(u("uMouse"), mx, my)
            // Raw 0..1: the FRAG scales it by the Advanced `hover` row (RULES.md).
            gl.uniform1f(u("uHover"), hov)
            gl.uniform3f(u("uBg"), bg[0], bg[1], bg[2])
            gl.uniform3f(u("uBase"), base[0], base[1], base[2])
            gl.uniform3f(u("uAccent"), acc[0], acc[1], acc[2])
            gl.uniform1f(u("uScale"), Math.max(10, Math.min(300, num(p.scale, 100))) / 100)
            effectUniforms(gl, u, p)
            gl.drawArrays(gl.TRIANGLES, 0, 3)
        }
        raf = requestAnimationFrame(frame)
        return () => {
            cancelAnimationFrame(raf)
            ro.disconnect()
            canvas.removeEventListener("pointermove", onMove)
            canvas.removeEventListener("pointerleave", onLeave)
        }
    }, [])

    return (
        <div ref={rootRef} style={{ position: "relative", width: "100%", height: "100%", minWidth: 1200, minHeight: 800, overflow: "hidden", background, ...style }}>
            <canvas ref={canvasRef} style={{ position: "absolute", inset: 0, width: "100%", height: "100%", display: "block" }} />
        </div>
    )
}

addPropertyControls(StarPanelTunnel, {
    background: { type: ControlType.Color, title: "Background", defaultValue: "#01020A" },
    baseColor: { type: ControlType.Color, title: "Base Color", defaultValue: "#1652E8" },
    accentColor: { type: ControlType.Color, title: "Accent Color", defaultValue: "#22C4F4" },
    speed: { type: ControlType.Number, title: "Speed", min: 0, max: 100, step: 1, defaultValue: 42 },
    scale: { type: ControlType.Number, title: "Scale", min: 10, max: 300, step: 1, unit: "%", defaultValue: 300 },
    // ── effect controls (≤ 3) ──
    walls: { type: ControlType.Number, title: "Walls", min: 3, max: 12, step: 1, defaultValue: 12 },
    flicker: { type: ControlType.Number, title: "Flicker", min: 0, max: 100, step: 1, unit: "%", defaultValue: 0 },
    glow: { type: ControlType.Number, title: "Glow", min: 0, max: 100, step: 1, unit: "%", defaultValue: 100 },
    hover: { type: ControlType.Number, title: "Hover", min: 0, max: 100, step: 1, unit: "%", defaultValue: 100 },
    advanced: {
        type: ControlType.Object,
        title: "Advanced",
        controls: {
            vanishX: { type: ControlType.Number, title: "Vanish X", min: 0, max: 100, step: 1, unit: "%", defaultValue: 50 },
            vanishY: { type: ControlType.Number, title: "Vanish Y", min: 0, max: 100, step: 1, unit: "%", defaultValue: 50 },
            wallTurn: { type: ControlType.Number, title: "Wall Turn", min: -180, max: 180, step: 1, unit: "°", defaultValue: 111 },
            focal: { type: ControlType.Number, title: "Focal", min: 5, max: 300, step: 1, defaultValue: 38 },
            flySpeed: { type: ControlType.Number, title: "Fly Speed", min: 0, max: 1000, step: 1, defaultValue: 189 },
            columns: { type: ControlType.Number, title: "Columns", min: 2, max: 60, step: 1, defaultValue: 27 },
            panelAspect: { type: ControlType.Number, title: "Panel Depth", min: 20, max: 400, step: 1, unit: "%", defaultValue: 139 },
            gap: { type: ControlType.Number, title: "Gap", min: 0, max: 80, step: 1, unit: "%", defaultValue: 0 },
            dimShare: { type: ControlType.Number, title: "Dim Panels", min: 0, max: 100, step: 1, unit: "%", defaultValue: 22 },
            litShare: { type: ControlType.Number, title: "Lit Panels", min: 0, max: 100, step: 1, unit: "%", defaultValue: 24 },
            hotShare: { type: ControlType.Number, title: "Hot Panels", min: 0, max: 100, step: 1, unit: "%", defaultValue: 4 },
            flashShare: { type: ControlType.Number, title: "Flashes", min: 0, max: 100, step: 1, unit: "%", defaultValue: 20 },
            flashMs: { type: ControlType.Number, title: "Flash Time", min: 50, max: 1500, step: 10, unit: "ms", defaultValue: 400 },
            holdMs: { type: ControlType.Number, title: "Panel Hold", min: 50, max: 5000, step: 10, unit: "ms", defaultValue: 600 },
            dimColor: { type: ControlType.Color, title: "Dim Panel", defaultValue: "#0B2A78" },
            deepColor: { type: ControlType.Color, title: "Dark Panel", defaultValue: "#050B1E" },
            hotColor: { type: ControlType.Color, title: "Hot Panel", defaultValue: "#8FE6FF" },
            flashColor: { type: ControlType.Color, title: "Flash", defaultValue: "#EAF8FF" },
            sparkColor: { type: ControlType.Color, title: "Spark", defaultValue: "#FFFFFF" },
            fog: { type: ControlType.Number, title: "Fog", min: 0, max: 100, step: 1, defaultValue: 8 },
            nearDim: { type: ControlType.Number, title: "Near Dim", min: 0, max: 100, step: 1, unit: "%", defaultValue: 12 },
            gradient: { type: ControlType.Number, title: "Panel Gradient", min: 0, max: 100, step: 1, unit: "%", defaultValue: 35 },
            sparkShare: { type: ControlType.Number, title: "Sparks", min: 0, max: 100, step: 1, unit: "%", defaultValue: 10 },
            sparkSize: { type: ControlType.Number, title: "Spark Size", min: 1, max: 50, step: 1, unit: "%", defaultValue: 6 },
            crease: { type: ControlType.Number, title: "Crease Dark", min: 0, max: 100, step: 1, unit: "%", defaultValue: 70 },
            edgeSoft: { type: ControlType.Number, title: "Near Blur", min: 0, max: 100, step: 1, unit: "%", defaultValue: 20 },
            exposure: { type: ControlType.Number, title: "Exposure", min: 10, max: 300, step: 1, unit: "%", defaultValue: 110 },
            grain: { type: ControlType.Number, title: "Grain", min: 0, max: 100, step: 1, unit: "%", defaultValue: 0 },
            vignette: { type: ControlType.Number, title: "Vignette", min: 0, max: 100, step: 1, unit: "%", defaultValue: 0 },
        },
    },
})
